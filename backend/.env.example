# Ambiente do Servidor FluencIA
NODE_ENV=development
PORT=3001

# Banco de Dados PostgreSQL
# Exemplo para PostgreSQL local ou container Docker:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fluenciadb?schema=public"

# Segurança e JWT
JWT_SECRET="fluencia_super_secret_jwt_key_educational_platform_2026"
JWT_EXPIRES_IN="24h"

# Controle de Origem CORS (endereço do frontend Vite/PWA)
CORS_ORIGIN="http://localhost:5173"

# Credenciais Iniciais do SUPERADMIN para Seed (NUNCA expor em repositório público)
SUPERADMIN_NAME="Super Administrador FluencIA"
SUPERADMIN_EMAIL="superadmin@fluencia.edu.br"
SUPERADMIN_PASSWORD="Fluencia@2026!SuperAdmin"

# Parâmetros Pedagógicos Globais
EVALUATION_DEFAULT_WORD_DURATION_SEC=10
EVALUATION_CRITERIA_VERSION="2026.1"
EVALUATION_SILENT_MODE_DURING_SPEECH=true
