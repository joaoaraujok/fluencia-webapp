# =============================================================================
# FluencIA Backend - Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com as suas configurações:
# cp .env.example .env
# =============================================================================

# Ambiente e Porta do Servidor
NODE_ENV=development
PORT=3001

# Banco de Dados Relacional (PostgreSQL via Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fluenciadb?schema=public"

# Segurança e Autenticação JWT (Utilize uma string segura com no mínimo 32 caracteres)
JWT_SECRET="sua_chave_secreta_jwt_para_ambiente_local_32_chars_min"
JWT_EXPIRES_IN="24h"

# Controle de Origem CORS (Endereço do frontend em desenvolvimento ou produção)
CORS_ORIGIN="http://localhost:5173"

# Credenciais Iniciais para Criação do SUPERADMIN no Seed (Personalize localmente)
SUPERADMIN_NAME="Super Administrador FluencIA"
SUPERADMIN_EMAIL="superadmin@fluencia.edu.br"
SUPERADMIN_PASSWORD="SuaSenhaForteAqui@123"

# Parâmetros Pedagógicos e Regras de Avaliação
EVALUATION_DEFAULT_WORD_DURATION_SEC=10
EVALUATION_CRITERIA_VERSION="2026.1"
EVALUATION_SILENT_MODE_DURING_SPEECH=true

# =============================================================================
# Provedores de Inteligência Artificial (Gratuitos)
# =============================================================================
# Groq Cloud - Whisper Large v3 Turbo (STT - Speech-to-Text de ultra-baixa latência)
# Obtenha sua chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY="gsk_sua_chave_groq_aqui"

# Google Gemini - Análise Fonética e Diagnóstico Pedagógico
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="sua_chave_google_gemini_aqui"
