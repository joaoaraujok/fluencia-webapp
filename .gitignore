# =============================================================================
# FluencIA - .gitignore
# =============================================================================

# Dependências
node_modules/
.pnp/
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Builds e bundles gerados
dist/
dist-ssr/
dev-dist/
build/
out/
*.bundle.js

# Cache e compilação do TypeScript
*.tsbuildinfo
next-env.d.ts

# Logs e depuração
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testes e cobertura de código
coverage/
.vitest/
.nyc_output/

# Variáveis de ambiente e segredos (em qualquer diretório)
**/.env
**/.env.*
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
!**/.env.example

# Bancos de dados locais, SQLite e migrações temporárias
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/prisma/*.db
backend/prisma/*.db-journal

# Uploads, gravações de áudio e arquivos temporários
uploads/
recordings/
temp/
tmp/

# Ferramentas de IA / Context Bundlers (Repomix, etc.)
repomix-output.*
*repomix*
*.repomix.*

# Chaves e certificados
*.pem
*.key
*.cert
*.crt

# IDEs e Editores
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Arquivos do Sistema Operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
